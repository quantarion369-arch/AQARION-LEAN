import Denom5InvariantPlaneFixed
import Init.Data.Rat.Lemmas
import Lean

set_option maxRecDepth 4000
set_option maxHeartbeats 2000000

namespace AQARION.Denom5RationalSpan

structure Vec3Q where
  a : Rat
  b : Rat
  c : Rat
  deriving DecidableEq, Repr

def balanced (x : Vec3Q) : Prop :=
  x.a = x.b

def zero : Vec3Q :=
  ⟨0, 0, 0⟩

def add (x y : Vec3Q) : Vec3Q :=
  ⟨x.a + y.a, x.b + y.b, x.c + y.c⟩

def scale (r : Rat) (x : Vec3Q) : Vec3Q :=
  ⟨r * x.a, r * x.b, r * x.c⟩

-- Row-vector multiplication by M = 5P.
def step5 (x : Vec3Q) : Vec3Q :=
  ⟨x.a + 2 * x.b + x.c,
   x.a + 2 * x.b + x.c,
   3 * x.a + x.b + 3 * x.c⟩

-- Row-vector multiplication by the stochastic matrix P.
def stepP (x : Vec3Q) : Vec3Q :=
  scale (1 / 5 : Rat) (step5 x)

def blockA (x : Vec3Q) : Vec3Q :=
  ⟨x.a, x.b, 0⟩

def blockB (x : Vec3Q) : Vec3Q :=
  ⟨0, 0, x.c⟩

def observation (x : Vec3Q) : Rat × Rat :=
  (x.a + x.b, x.c)

def initial : Vec3Q :=
  ⟨(1 / 4 : Rat), (1 / 4 : Rat), (1 / 2 : Rat)⟩

theorem initial_balanced : balanced initial := by
  rfl

theorem zero_balanced : balanced zero := by
  rfl

theorem add_balanced
    (x y : Vec3Q)
    (hx : balanced x) (hy : balanced y) :
    balanced (add x y) := by
  change x.a = x.b at hx
  change y.a = y.b at hy
  change x.a + y.a = x.b + y.b
  rw [hx, hy]

theorem scale_balanced
    (r : Rat) (x : Vec3Q) (hx : balanced x) :
    balanced (scale r x) := by
  change x.a = x.b at hx
  change r * x.a = r * x.b
  rw [hx]

theorem step5_balanced (x : Vec3Q) :
    balanced (step5 x) := by
  rfl

theorem stepP_balanced (x : Vec3Q) :
    balanced (stepP x) := by
  exact scale_balanced _ _ (step5_balanced x)

theorem blockA_balanced
    (x : Vec3Q) (hx : balanced x) :
    balanced (blockA x) := by
  exact hx

theorem blockB_balanced (x : Vec3Q) :
    balanced (blockB x) := by
  rfl

-- Finite operator words: transitions and block projections
-- may be applied in any finite order.
inductive WordVector : Vec3Q → Prop
  | seed : WordVector initial
  | transition {x : Vec3Q} :
      WordVector x → WordVector (stepP x)
  | observeA {x : Vec3Q} :
      WordVector x → WordVector (blockA x)
  | observeB {x : Vec3Q} :
      WordVector x → WordVector (blockB x)

theorem word_balanced
    {x : Vec3Q} (hx : WordVector x) :
    balanced x := by
  induction hx with
  | seed =>
      exact initial_balanced
  | transition hx ih =>
      exact stepP_balanced _
  | observeA hx ih =>
      exact blockA_balanced _ ih
  | observeB hx ih =>
      exact blockB_balanced _

-- An explicit finite rational linear-span construction.
-- Membership is generated by word vectors, zero,
-- vector addition, and multiplication by any rational.
inductive InSpan : Vec3Q → Prop
  | word {x : Vec3Q} :
      WordVector x → InSpan x
  | zero : InSpan AQARION.Denom5RationalSpan.zero
  | add {x y : Vec3Q} :
      InSpan x → InSpan y → InSpan (add x y)
  | scale (r : Rat) {x : Vec3Q} :
      InSpan x → InSpan (scale r x)

theorem span_balanced
    {x : Vec3Q} (hx : InSpan x) :
    balanced x := by
  induction hx with
  | word hw =>
      exact word_balanced hw
  | zero =>
      exact zero_balanced
  | add hx hy ihx ihy =>
      exact add_balanced _ _ ihx ihy
  | scale r hx ih =>
      exact scale_balanced r _ ih

theorem observation_kernel_trivial
    (x : Vec3Q)
    (hb : balanced x)
    (ho : observation x = (0, 0)) :
    x = zero := by
  have hab : x.a = x.b := hb
  have hs : x.a + x.b = 0 :=
    congrArg Prod.fst ho
  have hc : x.c = 0 :=
    congrArg Prod.snd ho
  have ha : x.a = 0 := by grind
  have hb0 : x.b = 0 := by grind
  cases x with
  | mk a b c =>
      change a = 0 at ha
      change b = 0 at hb0
      change c = 0 at hc
      cases ha
      cases hb0
      cases hc
      rfl

theorem span_observation_kernel_trivial
    (x : Vec3Q)
    (hx : InSpan x)
    (ho : observation x = (0, 0)) :
    x = zero := by
  exact observation_kernel_trivial x (span_balanced hx) ho

theorem observation_injective_on_span
    (x y : Vec3Q)
    (hx : InSpan x)
    (hy : InSpan y)
    (ho : observation x = observation y) :
    x = y := by
  have hxb : x.a = x.b := span_balanced hx
  have hyb : y.a = y.b := span_balanced hy
  have hs : x.a + x.b = y.a + y.b :=
    congrArg Prod.fst ho
  have hc : x.c = y.c :=
    congrArg Prod.snd ho
  have ha : x.a = y.a := by grind
  have hb : x.b = y.b := by grind
  cases x with
  | mk a b c =>
      cases y with
      | mk d e f =>
          change a = d at ha
          change b = e at hb
          change c = f at hc
          cases ha
          cases hb
          cases hc
          rfl

