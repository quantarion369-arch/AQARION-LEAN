import AqarionAnchorBase
namespace AqarionJoin

/-- Finite chains generated by a family of equivalence relations. -/
inductive Chain {X : Type} {I : Type}
    (E : I → Setoid X) : X → X → Prop
  | refl (x : X) : Chain E x x
  | step (i : I) {x y : X} :
      (E i).r x y → Chain E x y
  | trans {x y z : X} :
      Chain E x y → Chain E y z → Chain E x z

theorem chain_symm
    {X : Type} {I : Type} {E : I → Setoid X}
    {x y : X} (h : Chain E x y) :
    Chain E y x := by
  induction h with
  | refl x =>
      exact Chain.refl x
  | step i h =>
      exact Chain.step i ((E i).iseqv.symm h)
  | trans hxy hyz ihxy ihyz =>
      exact Chain.trans ihyz ihxy

/-- The equivalence relation generated by the family. -/
def joinSetoid
    {X : Type} {I : Type}
    (E : I → Setoid X) : Setoid X where
  r := Chain E
  iseqv := {
    refl := fun x => Chain.refl x
    symm := fun h => chain_symm h
    trans := fun hxy hyz => Chain.trans hxy hyz
  }

/-- Every generator is contained in the constructed relation. -/
theorem generator_inclusion
    {X : Type} {I : Type}
    (E : I → Setoid X) (i : I) :
    ∀ x y, (E i).r x y → (joinSetoid E).r x y := by
  intro x y h
  exact Chain.step i h

/-- Leastness: every equivalence relation containing the generators
also contains every generated finite chain. -/
theorem join_least
    {X : Type} {I : Type}
    (E : I → Setoid X) (R : Setoid X)
    (hcontains : ∀ i x y, (E i).r x y → R.r x y) :
    ∀ x y, (joinSetoid E).r x y → R.r x y := by
  intro x y h
  change Chain E x y at h
  induction h with
  | refl x =>
      exact R.iseqv.refl x
  | step i h =>
      exact hcontains i _ _ h
  | trans hxy hyz ihxy ihyz =>
      exact R.iseqv.trans ihxy ihyz

/-- A least-upper-bound characterization without relying on
a Mathlib lattice instance. -/
theorem join_universal_property
    {X : Type} {I : Type}
    (E : I → Setoid X) (R : Setoid X) :
    (∀ x y, (joinSetoid E).r x y → R.r x y) ↔
    (∀ i x y, (E i).r x y → R.r x y) := by
  constructor
  · intro h i x y hxy
    exact h x y (generator_inclusion E i x y hxy)
  · intro h
    exact join_least E R h

/-- Applying the dynamics to a chain preserves every step. -/
theorem chain_forward
    {X : Type} {I : Type}
    (T : X → X) (E : I → Setoid X)
    (hforward :
      ∀ i x y, (E i).r x y → (E i).r (T x) (T y))
    {x y : X} (h : Chain E x y) :
    Chain E (T x) (T y) := by
  induction h with
  | refl x =>
      exact Chain.refl (T x)
  | step i h =>
      exact Chain.step i (hforward i _ _ h)
  | trans hxy hyz ihxy ihyz =>
      exact Chain.trans ihxy ihyz

/-- Finite-anchor join rigidity.

Only the chosen anchor has a finite quotient and backward stability.
Every generator is assumed forward-preserved.
Neither the carrier nor the indexing family is assumed finite. -/
theorem finite_anchor_join_rigidity
    {X : Type} {I : Type}
    (T : X → X) (E : I → Setoid X) (a : I)
    (n : Nat)
    (enc : Quotient (E a) → Fin n)
    (dec : Fin n → Quotient (E a))
    (hleft : ∀ q, dec (enc q) = q)
    (hright : ∀ i, enc (dec i) = i)
    (hback :
      ∀ x y, (E a).r (T x) (T y) → (E a).r x y)
    (hforward :
      ∀ i x y, (E i).r x y → (E i).r (T x) (T y)) :
    ∀ x y,
      (joinSetoid E).r x y ↔
      (joinSetoid E).r (T x) (T y) := by
  apply AqarionAnchor.finite_anchor_rigidity
    T (E a) (joinSetoid E) n enc dec hleft hright hback
  · exact generator_inclusion E a
  · intro x y h
    exact chain_forward T E hforward h

#print axioms join_universal_property
#print axioms finite_anchor_join_rigidity

set_option pp.explicit true in
#check finite_anchor_join_rigidity

end AqarionJoin
