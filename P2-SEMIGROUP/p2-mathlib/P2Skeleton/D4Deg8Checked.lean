import Mathlib
import P2Skeleton.TraceChecker
import P2Skeleton.Densify

set_option autoImplicit false
set_option maxHeartbeats 0
set_option maxRecDepth 100000

namespace P2Skeleton.D4Deg8Checked

/-- Nonzero entries of the D4 degree-8 table (283 rows, 6 columns, 48 nonzeros) as
sparse rows (column, value), generated by the integral verifier from the frozen export
(sha256 1a9f22866a38f135859a41616f18a5756e7fdecc921a2f36b078c20db334a8a0). Its construction from the complex is not proved here. -/
def srows : List (List (ℕ × ℤ)) := [[], [(2, 1)], [], [(0, 1)], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [(1, 1)], [(0, -1)], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [(4, 1)], [], [], [(0, 1)], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [(3, 1)], [], [(0, -1)], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [(5, 1)], [], [], [(1, -1)], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [(3, -1)], [(1, 1)], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [(5, -1)], [], [(2, -1)], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [(4, -1)], [(2, 1)], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [(3, 1)], [], [], [(0, -1)], [], [(3, 1)], [], [], [(0, -1)], [(1, 1)], [], [], [], [], [], [(4, 1)], [], [(0, 1)], [], [], [(4, 1)], [], [(0, 1)], [], [(2, 1)], [], [], [], [], [], [], [(0, 1)], [], [], [], [], [(0, -1)], [], [], [], [(5, 1)], [], [(1, -1)], [], [], [(5, 1)], [], [(1, -1)], [(2, -1)], [], [], [], [], [], [], [], [(1, -1)], [], [], [], [], [(1, 1)], [], [], [], [], [(2, -1)], [], [], [], [], [(2, 1)], [], [], [(5, -1)], [], [], [(3, 1)], [], [(5, -1)], [], [], [(3, -1)], [(4, -1)], [], [], [], [], [], [], [], [(3, 1)], [], [], [], [], [(3, -1)], [], [], [], [], [(4, 1)], [], [], [], [], [(4, -1)], [], [], [], [], [(5, 1)], [], [], [], [], [(5, -1)], [], [], []]

def tab : List (List ℤ) := densify 6 srows

def trace : List (ℕ × ℕ) := [(3, 0), (22, 1), (1, 2), (62, 3), (41, 4), (81, 5)]

theorem check_ok : check 6 tab [] trace = true := by
  first | decide +kernel | decide

theorem rank_d4deg8_checked (K : Type) [Field K] :
    Matrix.rank (Matrix.of fun (a : Fin 283) (b : Fin 6) => ((cell tab a.val b.val : ℤ) : K))
      = 6 :=
  (rank_of_check 283 6 tab trace (by first | decide +kernel | decide) check_ok K).trans rfl

end P2Skeleton.D4Deg8Checked

