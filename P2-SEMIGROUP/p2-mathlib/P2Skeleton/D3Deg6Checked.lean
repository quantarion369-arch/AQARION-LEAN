import Mathlib
import P2Skeleton.TraceChecker
import P2Skeleton.Densify

set_option autoImplicit false
set_option maxHeartbeats 0
set_option maxRecDepth 100000

namespace P2Skeleton.D3Deg6Checked

/-- Nonzero entries of the D3 degree-6 table (188 rows, 8 columns, 51 nonzeros) as
sparse rows (column, value), generated by the integral verifier from the frozen export
(sha256 1a9f22866a38f135859a41616f18a5756e7fdecc921a2f36b078c20db334a8a0). Its construction from the complex is not proved here. -/
def srows : List (List (ℕ × ℤ)) := [[], [(6, 1)], [(4, 1)], [], [(0, 1), (1, 1)], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [(7, 1)], [], [(2, 1)], [(0, -1)], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [(5, 1)], [(3, 1)], [(1, -1)], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [(2, -1), (3, -1)], [], [], [], [(0, -1), (1, -1)], [(2, 1), (3, 1)], [], [], [], [], [(4, -1), (5, -1)], [], [], [(0, 1)], [], [(4, 1), (5, 1)], [], [], [], [], [(6, -1), (7, -1)], [], [(1, 1)], [], [], [(6, 1), (7, 1)], [], [], [], [], [], [(0, 1), (1, 1)], [], [], [], [], [(0, -1)], [], [], [], [], [(1, -1)], [], [], [(4, 1)], [], [], [], [(2, -1)], [(4, -1)], [], [], [], [], [(6, 1)], [], [], [(3, -1)], [], [(6, -1)], [], [], [], [], [], [], [(2, -1), (3, -1)], [], [], [], [], [(2, 1)], [], [], [], [], [(3, 1)], [], [(7, 1)], [], [], [], [(5, -1)], [(7, -1)], [], [], [], [], [], [], [], [(4, -1), (5, -1)], [], [], [], [], [(4, 1)], [], [], [], [], [(5, 1)], [], [], [], [], [(6, -1), (7, -1)], [], [], [], [], [(6, 1)], [], [], [], [], [(7, 1)], [], [], [], [], [], [], [], []]

def tab : List (List ℤ) := densify 8 srows

def trace : List (ℕ × ℕ) := [(4, 0), (24, 1), (23, 2), (63, 3), (2, 4), (73, 5), (1, 6), (83, 7)]

theorem check_ok : check 8 tab [] trace = true := by
  first | decide +kernel | decide

theorem rank_d3deg6_checked (K : Type) [Field K] :
    Matrix.rank (Matrix.of fun (a : Fin 188) (b : Fin 8) => ((cell tab a.val b.val : ℤ) : K))
      = 8 :=
  (rank_of_check 188 8 tab trace (by first | decide +kernel | decide) check_ok K).trans rfl

end P2Skeleton.D3Deg6Checked

